<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <PlatformTarget>x86</PlatformTarget>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
        <Using Include="Xunit" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/SF.Abstractions/SF.Abstractions.csproj" />
        <ProjectReference Include="../../src/SF.Runtime/SF.Runtime.csproj" />
        <!-- Plugin fixtures are built but never referenced: the tests copy them into a plugins directory and load them through PluginLoader. -->
        <ProjectReference Include="../Fixtures/Plugins/Provider/SF.Fixture.Provider.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../Fixtures/Plugins/Consumer/SF.Fixture.Consumer.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
