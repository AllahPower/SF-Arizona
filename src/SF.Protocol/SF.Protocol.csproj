<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>14</LangVersion>
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>false</IsTrimmable>
		<RootNamespace>SFSharp.Protocol</RootNamespace>
		<AssemblyName>SF.Protocol</AssemblyName>
		<Description>Native-free SA-MP packet and RPC models, parsers and RakNet-compatible managed bitstreams.</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\SF.Abstractions\SF.Abstractions.csproj" />
		<InternalsVisibleTo Include="SF.Runtime" />
		<InternalsVisibleTo Include="SF.Network.Tests" />
	</ItemGroup>

</Project>
