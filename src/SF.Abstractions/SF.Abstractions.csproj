<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>14</LangVersion>
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>false</IsTrimmable>
		<RootNamespace>SFSharp.Abstractions</RootNamespace>
		<AssemblyName>SF.Abstractions</AssemblyName>
		<PackageId>SFSharp.Abstractions</PackageId>
		<Description>Managed plugin contracts for SF: GTA and SA-MP services, module lifecycle, storage and network observation.</Description>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
	</ItemGroup>

</Project>
