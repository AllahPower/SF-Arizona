<Project>
  <PropertyGroup>
    <SFBaseVersion>5.0.0</SFBaseVersion>
    <Version Condition="'$(Version)' == ''">$(SFBaseVersion)</Version>
    <AssemblyVersion>$(SFBaseVersion).0</AssemblyVersion>
    <FileVersion>$(SFBaseVersion).0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
  </PropertyGroup>
</Project>
